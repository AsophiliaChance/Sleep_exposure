% =====================================================
% 画图（严格沿用你的代码）+ 每个被试的数据点 + 连线 + 保存 LMM 数据表
% =====================================================
set(groot,'defaultAxesTickLength',[0.03 0.06])
set(groot,'defaultAxesFontName','Times New Roman');
set(groot,'defaultTextFontName','Times New Roman');

% ---------- Amplitude ----------
clc
data = cat(3, amplitude_diff.mmn, amplitude_diff.p3);
figure('Position', [100 100 800 230])
componentTitles = {'Small P2','Large P2','Small P450','Large P450'};

T_all_ampl = cell(1,4);
amplitudeFE = cell(1,4);

for i = 1:4
    subplot(1,4,i); hold on
    
    Days = repmat((1:3)',20,1);       % 每个被试3天
    Subjects = repelem((1:20)',3);    % 20个被试
    Y = reshape(data(:,:,i),[],1);    % 展平矩阵
    n = 20;
    
    T = table(Subjects,Days,Y);
    T.Subjects = categorical(T.Subjects);
    T.Days = categorical(T.Days);
    T_all_ampl{i} = T;                         % 保存表格
    
    % 线性混合模型
    lme = fitlme(T, 'Y ~ Days + (1|Subjects)','FitMethod','REML');
    
    % 组平均与标准误
    if iscategorical(T.Days), T.DayNum = double(T.Days); else, T.DayNum = T.Days; end
    days_list = [2,3,4];
    mean_Y = groupsummary(T,"DayNum","mean","Y");
    sem_Y  = groupsummary(T,"DayNum","std","Y");
    sem_Y.std_Y  = sem_Y.std_Y / sqrt(n);
    
    % ----------- 绘制平均柱 + SEM ----------
    bar(days_list, mean_Y.mean_Y, 0.5, 'FaceAlpha',0.45, 'EdgeColor','none');
    errorbar(days_list, mean_Y.mean_Y, sem_Y.std_Y, 'k.', 'LineWidth',1, 'CapSize',5);
    
    % ----------- 叠加个体数据 + 连线 ----------
    jitter = 0.08;          % 抖动范围
    col_ind = [0.4 0.4 0.4];% 个体线灰色
    for s = 1:n
        % 取该被试的三个夜晚数值
        y_sub = Y((s-1)*3 + (1:3));
        % 对应X值（Night 2,3,4）+ 随机抖动
        x_sub = days_list + (rand(1,3)-0.5)*jitter;
        % 画线 + 点
        plot(x_sub, y_sub, '-o', 'Color', col_ind, ...
             'MarkerFaceColor', [0.7 0.7 0.7], ...
             'MarkerEdgeColor','none', 'LineWidth',0.8, 'MarkerSize',3);
    end
    
    % ----------- 坐标与标签 ----------
    ax = gca;
    if i <= 2
        ylim(ax,[-2 3]); ax.YTick=-2:1:3;
    else
        ylim(ax,[-1.1 6]); ax.YTick=-1:1:6;
    end
    xticks(days_list)
    set(gca, 'FontSize', 10, 'FontName','Times New Roman');
    if i==1
        xlabel('Night', 'FontSize', 15, 'FontWeight', 'bold');
        ylabel('Amplitude (μV)', 'FontSize', 15, 'FontWeight', 'bold');
    end
    title(componentTitles{i}, 'FontSize', 15, 'FontWeight', 'bold');
    
    % ----------- 显著性标记 ----------
    [~,~,FE] = fixedEffects(lme,'DFMethod','Satterthwaite');
    amplitudeFE{i}= FE;
    pvals = FE.pValue;
    p2star = @(p) repmat('*',1,(p<0.05)+(p<0.01)+(p<0.001));
    ySpan = range(ylim(ax));
    starOffset = 0.02*ySpan;
    nStar = 0;
    for d = 2:3
        if pvals(d) < 0.05
            nStar = nStar + 2;
            barTops = mean_Y.mean_Y([1 d-1]);
            yBase   = max(barTops);
            baseAdd = 0.45; if i==1, baseAdd = 0.15; end
            yLine = yBase + baseAdd + (nStar-1)*0.15;
            line([1.7 d+1.3],[yLine yLine], 'Parent',ax, 'Color','k','LineWidth',1.2);
            xMid = mean([2 d+1]); yStar = yLine + starOffset;
            text(xMid, yStar, p2star(pvals(d)), ...
                 'HorizontalAlignment','center','VerticalAlignment','middle','FontSize',12);
        end
    end
    hold off
end

sgtitle('Amplitude', 'FontWeight','bold', 'FontSize',20, 'FontName','Times New Roman');
print(gcf,'-dtiff','-r600','bar_amplitude_individual.tif');
